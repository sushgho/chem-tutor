# Optional. By default the frontend calls /api, which Next.js proxies to the backend.
# BACKEND_URL=http://localhost:8000
# Replace with the values from your Supabase project before using the app.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Sign-in is disabled by default; set true to require Supabase authentication.
# NEXT_PUBLIC_REQUIRE_SIGN_IN=false
