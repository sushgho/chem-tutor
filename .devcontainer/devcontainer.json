{
  "name": "Chemistry Tutor",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm install",
  "postStartCommand": "docker compose up -d",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Tutor app", "onAutoForward": "notify" },
    "8000": { "label": "Backend API" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "description": "Your Anthropic API key (console.anthropic.com)" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"] }
  }
}
